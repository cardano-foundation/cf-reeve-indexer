PORT=
VITE_VERSION=
VITE_API_URL=
# Document detail page (§9.5): base URLs this deployment trusts, used to compose links client-side.
# VITE_EXPLORER_URL + a tx hash -> explorer link; VITE_IPFS_GATEWAY_URL + a CID -> raw IPFS link.
VITE_EXPLORER_URL=
VITE_IPFS_GATEWAY_URL=

ENV=dev
RUN_IMAGE="node:20.12"
ENTRYPOINT=npm run dev

VITE_DATA_GRID_VIRTUALIZATION_OFF=